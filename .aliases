#!/bin/bash

alias .....="cd ../../../../"
alias ....="cd ../../../../"
alias ...="cd ../../../"
alias ..="cd .."
alias .4="cd ../../../../"
alias .5="cd ../../../../.."
alias cd..="cd .."
alias chgrp="chgrp"
alias chmod="chmod"
alias chown="chown"
alias ci="code-insiders"
alias cp="cp -i"
alias cld="clean_dependencies"
alias bmd="bump_dependencies"
alias cmbd="cld && bmd && dum install && dum build"
alias df="pydf"
alias docker_prune="docker system prune && docker volume prune"
alias find="find . -type d \( -iname node_modules -o -iname vendor -o -iname dist -o -iname target -o -iname \.git -o -iname \.next -o -iname \.venv \) -prune -false -o "
alias header="curl -I"
alias headerc="curl -I --compress"
alias ll="ls -la"
alias ln="ln -i"
alias ls="ls -FAlhG --color=always"
alias mkdir="mkdir -pv"
alias mv="mv -i"
alias grep="grep --color"
alias gb="git blame -w -C -C -C -L"
alias gs="git status"
alias nocomment="grep -Ev '\''^(#|$)'\''"
alias ports="netstat -tulanp"
alias prettify="prettier --cache --config ~/Developer/prettier.config.mjs --ignore-path ~/Developer/.prettierignore --logLevel error"
alias psg="ps aux | grep -v grep | grep -i -e VSZ -e"
alias rm="rm -I"
alias rsync="rsync --compress --copy-links --devices --exclude '.git' --group --human-readable --inplace --owner --partial --perms --recursive --specials --stats --times"
alias update_system="sudo apt-get update -y && sudo apt-get upgrade -y && sudo apt-get dist-upgrade -y && sudo apt full-upgrade -y && sudo apt-get autoremove -y && sudo apt-get clean"
alias wget="wget -c"
alias gptcommit="gpt-commit.py"
alias Think="Ask --extra-body '{\"chat_template_kwargs\": {\"thinking\": true}}'"
alias homegit='git --git-dir=/Volumes/CORSAIR/Developer/macOS/Application/NikolaRHristov/Home --work-tree=$HOME'
