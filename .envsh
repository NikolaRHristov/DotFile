#!/bin/bash

# shellcheck disable=SC2148
# ==============================================================================
#                 CENTRAL ENVIRONMENT VARIABLE DEFINITIONS
# ==============================================================================
# Single source of env vars for BOTH shells:
#   - zsh: sourced from ~/.zshenv on every zsh invocation
#   - bash: sourced from ~/.bashrc and ~/.profile (guarded)
# Order matters: CORSAIR first (dependencies), then tool roots, rust, python,
# general, telemetry, then PATH appends (deduplicated, at the end).
# Keep this file fast: exports only, one guarded GPG_TTY subprocess.

# --- Primary Mount Point ---
export CORSAIR="/Volumes/CORSAIR"

# --- Tool-Specific Environment Variables ---
export ZSH="$HOME/ZSH"             # Oh My Zsh installation directory
export NVM_DIR="$CORSAIR/Tool/NVM" # Authoritative NVM dir
export BUN_INSTALL="$CORSAIR/Tool/macOS/bun"
export PNPM_HOME="$CORSAIR/Tool/macOS/pnpm/global"
case ":$PATH:" in
*":$PNPM_HOME/bin:"*) ;;
*) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# --- Rust & Cargo (homes + artifacts on external SSD) ---
export RUSTC_WRAPPER="sccache"
export RUSTUP_HOME="$CORSAIR/Tool/macOS/rust/rustup"
export CARGO_HOME="$CORSAIR/Tool/macOS/rust/cargo"
export CARGO_NET_GIT_FETCH_WITH_CLI=true
export SCCACHE_DIR="$CORSAIR/Tool/macOS/rust/sccache"
export SCCACHE_CACHE_SIZE="50G"

# --- Python / uv ---
export UV_CACHE_DIR="$CORSAIR/Tool/macOS/python/uv_cache"
export UV_SYSTEM_CERTS=1
export UV_LINK_MODE=copy

# --- General Environment Variables ---
export LANG="en_US.UTF-8"
export EDITOR="code-insiders"
# Only set GPG_TTY when a real TTY is attached (avoids subprocess + error in non-interactive shells)
# shellcheck disable=SC2155
[ -t 0 ] && export GPG_TTY=$(tty)
export AWS_CLI_AUTO_PROMPT="on-partial"
export GIT_DISCOVERY_ACROSS_FILESYSTEM=1
export COREPACK_ENABLE_AUTO_PIN=0
export CEF_PATH="$HOME/.local/share/cef"
export ARCHFLAGS="-arch x86_64"           # was bash-only; now both shells - verify no impact
export BASH_SILENCE_DEPRECATION_WARNING=1 # bash-only meaning, harmless elsewhere
export OSH="$HOME/Bash"                   # Oh My Bash install dir (bash)
export ELECTRON_SKIP_BINARY_DOWNLOAD=1
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# --- Telemetry Opt-Out ---
export ADBLOCK=true
export AIO_TELEMETRY_DISABLED=1
export AMPLIFY_DISABLE_TELEMETRY=1
export ASTRO_TELEMETRY_DISABLED=1
export AUTOMATEDLAB_TELEMETRY_OPTOUT=1
export AWS_BLOCKS_DISABLE_TELEMETRY=1
export AZURE_CORE_COLLECT_TELEMETRY=0
export AZURE_DEV_COLLECT_TELEMETRY=no
export CHECKPOINT_DISABLE=1
export CHOOSENIM_NO_ANALYTICS=1
export CONTINUE_TELEMETRY_ENABLED=0
export DIEZ_DO_NOT_TRACK=1
export DISABLE_ERROR_REPORTING=1
export DISABLE_TELEMETRY=1
export DISABLE_ZAPIER_ANALYTICS=1
export DO_NOT_TRACK=1
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_INTERACTIVE_CLI_TELEMETRY_OPTOUT=1
export ET_NO_TELEMETRY=1
export GATSBY_TELEMETRY_DISABLED=1
export GATSBY_TELEMETRY_OPT_OUT=1
export GATSBY_TELEMETRY_OPTOUT=1
export GH_TELEMETRY=false
export HASURA_GRAPHQL_ENABLE_TELEMETRY=false
export HINT_TELEMETRY=off
export HOMEBREW_NO_ANALYTICS=1
export ICP_TELEMETRY_DISABLED=1
export INFLUXD_REPORTING_DISABLED=true
export ITERATIVE_DO_NOT_TRACK=1
export KIMI_DISABLE_TELEMETRY=1
export MERCUR_DISABLE_TELEMETRY=true
export NEXT_TELEMETRY_DISABLED=1
export NG_CLI_ANALYTICS=false
export NO_TELEMETRY=1
export NUXT_TELEMETRY_DISABLED=1
export OTEL_LOGS_EXPORTER=none
export OTEL_METRICS_EXPORTER=none
export OTEL_TRACES_EXPORTER=none
export PIN_DO_NOT_TRACK=1
export POWERSHELL_TELEMETRY_OPTOUT=1
export PP_TOOLS_TELEMETRY_OPTOUT=1
export RAILWAY_NO_TELEMETRY=1
export SAM_CLI_TELEMETRY=0
export SF_DISABLE_TELEMETRY=true
export SLS_TELEMETRY_DISABLED=1
export STNOUPGRADE=1
export STORYBOOK_DISABLE_TELEMETRY=1
export STRIPE_CLI_TELEMETRY_OPTOUT=1
export TELEMETRY_DISABLED=1
export TERRAFORM_TELEMETRY=0
export TURBO_TELEMETRY_DISABLED=1
export VCPKG_DISABLE_METRICS=1

aio telemetry off
ampx configure telemetry disable
gh config set telemetry disabled
go telemetry off
netlify --telemetry-disable
pac telemetry disable
sf config set disable-telemetry=true --global

# --- Misc ---
export NODE_EXTRA_CA_CERTS=/Library/Keychains/System.keychain

# --- PATH appends (deduplicated, applied last) ---
# zsh: ~/.zshenv's path array rebuilds PATH and already includes these dirs;
#      typeset -U collapses the duplicates. bash: these take effect as-is.
# Homebrew first here so /opt/homebrew/bin precedes /usr/bin in every context
# (user dirs below still take priority; brew shellenv re-prepends in rc files).
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="$HOME/.composer/vendor/bin:$PATH"
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
export PATH="$HOME/.actual/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
